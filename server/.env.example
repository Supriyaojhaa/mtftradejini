# Server Configuration
PORT=3001
NODE_ENV=development

# Market Data Feed Provider
# Options: 'auto' | 'upstox' | 'dhan' | 'yahoo'
MARKET_DATA_PROVIDER=auto

# Upstox API v2 Credentials (Optional - if using Upstox primary feed)
UPSTOX_ACCESS_TOKEN=

# DhanHQ API Credentials (Optional - if using DhanHQ feed)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Streaming & Cache Configuration
STREAM_INTERVAL_MS=8000
CACHE_TTL_SEC=20
